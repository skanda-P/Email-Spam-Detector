# Copy this file to ../.env (project root) and fill in your values.
# Never commit the real .env — it is listed in .gitignore.

# ── Server ────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ── Model paths (relative to backend/) ───────────────────
MODEL_PATH=./models/hybrid_spam_model.pt
SCALER_PATH=./models/scaler.joblib

# ── RoBERTa encoder ───────────────────────────────────────
ENCODER_NAME=roberta-base

# ── Inference ─────────────────────────────────────────────
SPAM_THRESHOLD=0.5
MAX_TOKEN_LEN=256
